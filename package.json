{
  "name": "mind-mapper",
  "version": "0.1.0",
  "description": "Renders a Markdown note as a mind map.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "version": "node scripts/version-bump.mjs",
    "release": "npm run check && node scripts/release.mjs",
    "fixtures:pull": "node scripts/dev-vault.mjs pull-fixtures"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "jsdom": "^31.0.0",
    "obsidian": "1.14.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
