{
  "name": "obsidian-plugin-mind-mapper-development",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5.2.5-26-trixie",
  "features": {
    "ghcr.io/devcontainers-extra/features/claude-code:latest": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/kingofkalk/devcontainer-features/home-persistence:1": {
      "directories": "~/.claude;~/.config/gh",
      "files": "~/.claude.json"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "chat.agent.enabled": false,
        "editor.formatOnSave": true,
        "git.openRepositoryInParentFolders": "always",
        "telemetry.telemetryLevel": "off",
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "zsh",
            "icon": "terminal"
          }
        }
      }
    }
  },
  "postCreateCommand": "bash scripts/install-e2e-deps.sh"
}
